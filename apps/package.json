{
  "name": "@zqdouyin/apps",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": { "node": ">=24.12.0" },
  "workspaces": [
    "admin",
    "admin-web",
    "viewer",
    "python-bridge"
  ],
  "scripts": {
    "check": "bun run --filter '@zqdouyin/*' check",
    "test": "bun run --filter @zqdouyin/admin test && bun run --filter @zqdouyin/viewer test && bun run --filter @zqdouyin/admin-web test",
    "build": "bun run --filter @zqdouyin/admin-web build"
  },
  "type": "module"
}
